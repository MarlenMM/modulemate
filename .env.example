# All core study tools work with these unset. Copy to .env only if needed.
# Configure any compatible chat-completions provider; choose its model explicitly.
MODULEMATE_AI_BASE_URL=https://api.openai.com/v1
MODULEMATE_AI_MODEL=
MODULEMATE_AI_API_KEY=
# Keep data outside a public/static directory. Defaults to ./data/modulemate.sqlite3.
# MODULEMATE_DATA_DIR=/absolute/private/path
# Disable self-registration after creating your account on a shared deployment.
MODULEMATE_ALLOW_REGISTRATION=true
