# Optional OpenAI-compatible server; hosted providers need HTTPS and a key.
# Loopback servers can leave the key empty. Select/enable it in the sidebar.
MODULEMATE_AI_BASE_URL=https://api.openai.com/v1
MODULEMATE_AI_MODEL=
MODULEMATE_AI_API_KEY=

# One local workspace. There is no registration or login setting.
# MODULEMATE_DATA_DIR=/absolute/private/path
MODULEMATE_LOCAL_ML=auto
MODULEMATE_CHAT=auto
# 9b (default) or 4b; prepare and run using the same selection.
MODULEMATE_CHAT_VARIANT=9b
# Optional NLI research diagnostic; disabled after false-positive experiments.
# Run scripts/prepare_support_model.py before explicitly enabling auto.
MODULEMATE_SUPPORT=off
# MODULEMATE_MODEL_DIR=/absolute/path/to/retrieval-weights
# MODULEMATE_CHAT_MODEL_DIR=/absolute/path/to/conversational-weights
