# ModuleMate — copy to .env and fill in the key for your chosen backend.
# Which variable is read is set by generation.api_key_env in config.yaml.

# Default backend: Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=gsk_...

# Alternatives — set generation.backend / base_url / model in config.yaml to match.
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
